
:root {
  font-family: system-ui, -apple-system, "Noto Sans Bengali", sans-serif;
  color: #182923;
  background: #f5f7f4;
  --green: #176a4c;
  --dark: #102b24;
  --border: #e1e9e3;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

header {
  background: var(--dark);
  color: white;
  padding: 23px 17px 28px;
}

.wrap {
  max-width: 760px;
  margin: auto;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.brand {
  font-size: 28px;
  font-weight: 850;
  letter-spacing: 1px;
}

.tag {
  font-size: 13px;
  color: #c9ded2;
  margin-top: 3px;
}

.lang {
  border: 1px solid #729084;
  background: transparent;
  color: white;
  padding: 9px 12px;
  border-radius: 10px;
}

h1 {
  font-size: 26px;
  line-height: 1.4;
  margin: 25px 0 8px;
}

.intro {
  color: #d3e4dc;
  line-height: 1.75;
  margin: 0;
}

main {
  max-width: 760px;
  margin: auto;
  padding: 17px 13px 35px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  margin-bottom: 17px;
}

.stat,
.panel,
.item {
  background: white;
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 14px;
}

.stat strong {
  display: block;
  font-size: 23px;
  color: var(--green);
}

.stat span {
  font-size: 12px;
  color: #5e7066;
}

.panel {
  margin-bottom: 15px;
}

h2 {
  font-size: 19px;
  margin: 0 0 13px;
}

h3 {
  font-size: 16px;
}

label {
  display: block;
  font-size: 13px;
  font-weight: 650;
  margin: 11px 0 6px;
}

input,
select {
  width: 100%;
  min-width: 0;
  padding: 12px;
  border: 1px solid #ccd8cf;
  border-radius: 10px;
  background: white;
  color: #182923;
}

input:focus,
select:focus,
button:focus-visible,
a:focus-visible {
  outline: 2px solid #74b89a;
  outline-offset: 2px;
}

.fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.primary {
  border: 0;
  background: var(--green);
  color: white;
  border-radius: 10px;
  padding: 12px 15px;
  font-weight: 700;
}

.full {
  width: 100%;
  margin-top: 13px;
}

.tools {
  display: grid;
  grid-template-columns: 1fr 135px;
  gap: 9px;
  margin-bottom: 13px;
}

.item {
  margin-bottom: 10px;
}

.itemtop {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: start;
}

.item h3 {
  margin: 0 0 5px;
  overflow-wrap: anywhere;
}

.meta,
.note {
  font-size: 12px;
  color: #607168;
  line-height: 1.8;
}

.pill {
  font-size: 11px;
  background: #e8f4ec;
  color: var(--green);
  padding: 4px 8px;
  border-radius: 20px;
  white-space: nowrap;
}

.item a,
.directory a {
  color: var(--green);
  overflow-wrap: anywhere;
}

.item a {
  display: inline-block;
  margin-top: 8px;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.small {
  border: 1px solid #ccd8cf;
  background: white;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 12px;
  color: #203b2e;
}

.danger {
  color: #a33333;
}

.empty {
  text-align: center;
  padding: 23px 10px;
  color: #617168;
  line-height: 1.8;
}

.directory h3 {
  margin: 20px 0 7px;
}

.directory p {
  margin: 8px 0;
}

.directory a {
  font-weight: 600;
}

footer {
  text-align: center;
  color: #617168;
  font-size: 12px;
  padding: 18px;
}

.notice {
  padding: 10px 12px;
  border-radius: 10px;
  background: #eef5ef;
  font-size: 12px;
  line-height: 1.8;
  color: #355345;
  margin-top: 12px;
}

[hidden] {
  display: none !important;
}

@media (max-width: 430px) {
  .fields {
    grid-template-columns: 1fr;
  }

  .tools {
    grid-template-columns: 1fr 112px;
  }

  h1 {
    font-size: 23px;
  }

  .stat {
    padding: 10px 7px;
  }

  .stat span {
    font-size: 11px;
  }

  .stat strong {
    font-size: 21px;
  }
}
